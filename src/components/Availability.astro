---
import { site } from '../config/site';
import { t, type Locale } from '../i18n';

interface Props { locale: Locale; class?: string }
const { locale, class: cls } = Astro.props;
const c = t(locale);
const show = site.availability.enabled && c.site.availability.enabled;
---
{show && <p class:list={['availability', cls]}>{c.site.availability.text}</p>}
