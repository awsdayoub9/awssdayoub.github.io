---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'outline' | 'text';
  /** Opens in a new tab (WhatsApp only, per spec §7.4); pass the sr-only label too. */
  newTab?: boolean;
  newTabLabel?: string;
  block?: boolean;
  class?: string;
}
const { href, variant = 'primary', newTab = false, newTabLabel, block = false, class: cls, ...rest } = Astro.props;
const external = /^https?:/.test(href);
---
<a
  class:list={['btn', `btn--${variant}`, { 'btn--block': block }, cls]}
  href={href}
  target={newTab ? '_blank' : undefined}
  rel={newTab || external ? 'noopener' : undefined}
  {...rest}
>
  <slot />{newTab && newTabLabel && <span class="sr-only">{' '}{newTabLabel}</span>}
</a>
