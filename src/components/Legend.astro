---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).legend;
---
<ul class="legend mono" aria-label={c.label}>
  <li><span class="swatch swatch--custom" aria-hidden="true"></span>{c.custom}</li>
  <li><span class="swatch" aria-hidden="true"></span>{c.standard}</li>
  <li><span class="swatch swatch--ext" aria-hidden="true"></span>{c.external}</li>
</ul>
